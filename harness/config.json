{
  "kitVersion": "0.2.2",
  "project": {
    "name": "对译 Duiyi Android",
    "language": "android"
  },
  "paths": {
    "docs": "docs",
    "references": "references",
    "harness": "harness",
    "plans": "harness/plans",
    "evidence": "harness/evidence",
    "reviews": "harness/reviews",
    "tools": "tools",
    "rootDocs": [
      "AGENTS.md"
    ]
  },
  "instructions": {
    "root": "AGENTS.md",
    "nested": [
      "docs/AGENTS.md",
      "harness/AGENTS.md"
    ],
    "nestedMaxBytes": 8192,
    "budgets": {
      "AGENTS.md": 1200,
      "references/contracts.md": 700,
      "references/verification.md": 700,
      "references/workflow.md": 700
    },
    "sensitivePatterns": [
      "/local/",
      "/local/",
      "sk-"
    ]
  },
  "docs": {
    "publicWhitelist": [
      "README.md",
      "AGENTS.md",
      "docs/README.md",
      "docs/AGENTS.md",
      "docs/01-product-prototype.md",
      "docs/02-architecture.md",
      "docs/03-tech-choices.md",
      "docs/04-implementation-principles.md",
      "docs/05-obstacles.md",
      "docs/06-compromises.md",
      "docs/07-roadmap.md",
      "docs/08-on-device-llm.md",
      "docs/09-current-state.md",
      "docs/10-latency-optimization.md"
    ],
    "publicBudget": 16,
    "rootMarkdownAllowed": [
      "README.md",
      "AGENTS.md",
      "HARNESS.md",
      "CONTRIBUTING.md",
      "CLAUDE.md"
    ]
  },
  "commands": {
    "check": "make check",
    "verify": "make verify-static",
    "test": "./scripts/verify-unit.sh"
  },
  "claims": [
    {
      "name": "tests-pass",
      "type": "test-count",
      "baseline": "harness/test-baseline.json",
      "floor": "unit.floor",
      "expectedSkipped": "unit.expectedSkipped",
      "requireArtifact": false,
      "command": "./scripts/verify-unit.sh"
    },
    {
      "name": "docs-pass",
      "type": "static",
      "command": "python3 tools/check_docs.py"
    }
  ],
  "freshness": {
    "tests-pass": [
      "app/**",
      "gradle/**",
      "**/*.kt",
      "**/*.cpp",
      "**/*.gradle",
      "**/*.gradle.kts",
      "gradle.properties",
      "settings.gradle.kts",
      "gradlew*"
    ],
    "docs-pass": [
      "docs/**",
      "references/**",
      "AGENTS.md",
      "harness/**"
    ]
  },
  "adapters": {
    "claudeCode": {
      "skillsSource": ".dsh/skills",
      "skillsTarget": ".claude/skills"
    }
  }
}
