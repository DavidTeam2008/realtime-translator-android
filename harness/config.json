{
  "kitVersion": "0.2.2",
  "project": {
    "name": "对译 Duiyi Android",
    "language": "android"
  },
  "paths": {
    "docs": "docs",
    "references": "references",
    "harness": "harness",
    "plans": "harness/plans",
    "evidence": "harness/evidence",
    "reviews": "harness/reviews",
    "tools": "tools",
    "rootDocs": [
      "AGENTS.md"
    ]
  },
  "instructions": {
    "root": "AGENTS.md",
    "nested": [
      "docs/AGENTS.md",
      "harness/AGENTS.md"
    ],
    "nestedMaxBytes": 8192,
    "budgets": {
      "AGENTS.md": 1200,
      "references/contracts.md": 700,
      "references/verification.md": 700,
      "references/workflow.md": 700
    },
    "sensitivePatterns": [
      "/local/",
      "/local/",
      "sk-"
    ]
  },
  "docs": {
    "publicWhitelist": [
      "README.md",
      "AGENTS.md",
      "docs/README.md",
      "docs/AGENTS.md",
      "docs/01-product.md",
      "docs/02-architecture.md",
      "docs/03-decisions.md",
      "docs/04-runtime.md",
      "docs/05-known-issues.md",
      "docs/06-roadmap.md",
      "docs/07-on-device-llm.md",
      "docs/08-latency.md",
      "docs/09-current-state.md"
    ],
    "publicBudget": 16,
    "rootMarkdownAllowed": [
      "README.md",
      "AGENTS.md",
      "HARNESS.md",
      "CONTRIBUTING.md",
      "CLAUDE.md"
    ]
  },
  "commands": {
    "check": "make check",
    "verify": "make verify-static",
    "test": "./scripts/verify-unit.sh"
  },
  "claims": [
    {
      "name": "tests-pass",
      "type": "test-count",
      "baseline": "harness/test-baseline.json",
      "floor": "unit.floor",
      "expectedSkipped": "unit.expectedSkipped",
      "requireArtifact": false,
      "command": "./scripts/verify-unit.sh"
    },
    {
      "name": "docs-pass",
      "type": "static",
      "command": "python3 tools/check_docs.py"
    }
  ],
  "freshness": {
    "tests-pass": [
      "app/**",
      "gradle/**",
      "**/*.kt",
      "**/*.cpp",
      "**/*.gradle",
      "**/*.gradle.kts",
      "gradle.properties",
      "settings.gradle.kts",
      "gradlew*"
    ],
    "docs-pass": [
      "docs/**",
      "references/**",
      "AGENTS.md",
      "harness/**"
    ]
  },
  "adapters": {
    "claudeCode": {
      "skillsSource": ".dsh/skills",
      "skillsTarget": ".claude/skills"
    }
  },
  "layers": {
    "sourceRoot": "app/src/main/java/com/duiyi/android",
    "domainForbidden": [
      "android.",
      "androidx.",
      "com.duiyi.android.app",
      "com.duiyi.android.features",
      "com.duiyi.android.services",
      "com.duiyi.android.designsystem"
    ],
    "servicesForbidden": [
      "com.duiyi.android.features",
      "com.duiyi.android.designsystem"
    ],
    "featuresForbiddenImports": [
      "com.duiyi.android.services",
      "androidx.room",
      "android.database"
    ],
    "featuresServicesAllowlist": [
      "com.duiyi.android.services.ComputeGate",
      "com.duiyi.android.services.LatencyProbe",
      "com.duiyi.android.services.assets.DeviceAssetCatalog",
      "com.duiyi.android.services.speech.SherpaModelStore",
      "com.duiyi.android.services.speech.SpeechEngineException",
      "com.duiyi.android.services.speech.SpeechIntentBridge",
      "com.duiyi.android.services.speech.SpeechRecognizerFactory",
      "com.duiyi.android.services.translation.TranslationPump"
    ],
    "engineClasses": [
      "SherpaSpeech",
      "AndroidSpeechEngine",
      "GemmaTranslator",
      "LlamaNative"
    ],
    "engineAllowedPaths": [
      "app/src/main/java/com/duiyi/android/services/**",
      "app/src/main/java/com/duiyi/android/app/**",
      "app/src/main/java/com/duiyi/android/debug/**"
    ]
  },
  "hygiene": {
    "trackedArtifactGlobs": [
      "app/build/**",
      "app/.cxx/**",
      "**/__pycache__/**",
      "*.pyc",
      "*.class",
      "*.apk",
      "*.aab",
      "*.log",
      "*.hprof",
      ".DS_Store",
      "local.properties",
      "**/.gradle/**",
      "**/.idea/**",
      "**/.kotlin/**"
    ],
    "rootAllowlist": [
      "README.md",
      "AGENTS.md",
      "HARNESS.md",
      "CONTRIBUTING.md",
      "Makefile",
      ".gitignore",
      "build.gradle.kts",
      "settings.gradle.kts",
      "gradle.properties",
      "gradlew",
      "gradlew.bat"
    ],
    "localPathPatterns": [
      "/local/",
      "/local/",
      "/home/"
    ],
    "skipLocalPathScan": [
      "docs/_archive/",
      "harness/config.json",
      "harness/plans/",
      "harness/reviews/",
      "tools/check_agents.py",
      "tools/check_hygiene.py"
    ],
    "maxTrackedFileBytes": 5242880
  }
}
